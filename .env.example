# Server Environment Variables
# Copy this file to server/.env and fill in your values

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/uscdle?retryWrites=true&w=majority

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Server Config
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Client Environment Variables (client/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
